# file system/dockerfile v1.4
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y \
	mc build-essential git libncurses-dev zlib1g-dev subversion mercurial autoconf libtool libssl-dev libglib2.0-dev libgmp-dev \
	libmpc-dev libmpfr-dev texinfo gawk python3 python3-setuptools rsync unzip wget file zstd xz-utils ca-certificates \
	&& rm -rf /var/lib/apt/lists/*
COPY system/openssl.cnf /etc/ssl/openssl.cnf
WORKDIR /builder_workspace
